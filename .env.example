# Ollama model used by M1 and M2 text/entity extraction.
AUTOMATIC_WORKFLOW_OLLAMA_MODEL=gemma3:12b

# Optional M2-specific Ollama model. Must be one of `python M2-Entities/main.py --list-models`.
# AUTOMATIC_WORKFLOW_M2_OLLAMA_MODEL=gemma3:12b

# Optional M3-specific Ollama model used to choose geographic vs normal slides.
# AUTOMATIC_WORKFLOW_M3_OLLAMA_MODEL=gemma3:12b

# StoryMap narrative cover image.
AUTOMATIC_WORKFLOW_COVER_IMAGE=https://tool.dlnarratives.eu/images/title-background.jpg

# Contact-compliant User-Agent for Wikimedia API calls.
# Replace with a real project/contact address before production use.
AUTOMATIC_WORKFLOW_WIKIDATA_USER_AGENT=automatic-workflow/1.0 (contact: workflow@example.org)

# Optional explicit Java executable used by M3 Triplify.
# AUTOMATIC_WORKFLOW_JAVA_BIN=C:\\Program Files\\Java\\bin\\java.exe

# Set to 1 if OWL generation must fail the pipeline when Triplify fails.
AUTOMATIC_WORKFLOW_REQUIRE_OWL=0

# Logging level: DEBUG, INFO, WARNING, ERROR.
AUTOMATIC_WORKFLOW_LOG_LEVEL=INFO
